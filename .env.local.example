# Example environment variables for LiteLLM Proxy with Local Models
# Copy this to .env.local and customize as needed

# LM Studio Configuration
# Default port for LM Studio API is 1234
LM_STUDIO_API_BASE=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=

# Ollama Configuration
# Default port for Ollama API is 11434
OLLAMA_API_BASE=http://host.docker.internal:11434

# Proxy Server Configuration
PROXY_PORT=4000
PROXY_LOG_LEVEL=INFO

# Optional: Enable authentication
# LITELLM_MASTER_KEY=sk-your-master-key-here

# Optional: Database configuration (if using database storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/litellm

# Optional: Model pricing and tracking
# STORE_MODEL_IN_DB=True

# Optional: Enable detailed logging
# DEBUG=True
